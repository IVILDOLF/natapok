;; ============================================================
;;  kanata config - generated from ansi-104-internal.json (KLE)
;;
;;  LAYERS  (file order matters: later layer = higher priority
;;           when several are active at once)
;;    0 base : QWERTY                 <- starting layer
;;    1 apt  : APT v3 angle           <- double-tap [  (English only)
;;    2 nav  : double-tap Ctrl        ; double-tap Ctrl again to leave
;;    3 sym  : double-tap '           ; double-tap '    again to leave
;;    4 fn   : hold Fn (Z) while in nav
;;
;;  Enter and exit use the same key now, so the two overlays are
;;  symmetric:
;;    Ctrl Ctrl -> nav ... Ctrl Ctrl -> back
;;    '    '    -> sym ... '    '    -> back
;;  Crossing over also works: double-tap ' inside nav jumps straight to
;;  sym, double-tap Ctrl inside sym jumps straight to nav.
;;
;;  SHIFT (physical Tab) is ONE-SHOT on every layer:
;;    tap        -> next key press is shifted, then Shift is dropped
;;    tap again  -> cancels a pending one-shot (nothing gets shifted)
;;    hold       -> plain Shift, exactly as before (drag-select, etc.)
;;    Alt + Tab  -> still the OS language toggle (see @sft / @lang)
;;
;;  nav / sym are OVERLAYS (layer-while-held driven by virtual keys)
;;  instead of layer-switch. That is what makes a transparent `_` fall
;;  through to whichever base layout is live - base or apt.
;;
;;  Only the 4 rows below are touched. Function row, number row,
;;  arrows, navigation cluster and numpad keep their stock behaviour.
;; ============================================================

(defcfg
  process-unmapped-keys no
  ;; NOTE on the one-shot Shift: keys that are NOT in defsrc (the number
  ;; row, arrows, numpad...) are invisible to kanata while this is `no`,
  ;; so they cannot end a pending one-shot. Shift+3 still types "#", but
  ;; the Shift keeps hanging until the $os timeout expires or until you
  ;; press a key that IS in defsrc. If that bothers you, switch to:
  ;;   process-unmapped-keys yes
  ;; (on Windows also look at the `windows-altgr` option first if you
  ;;  type Polish characters with right Alt).

  ;; Linux only - uncomment and point at your device if autodetect misbehaves:
  ;; linux-dev /dev/input/by-id/your-keyboard-event-kbd
)

(defsrc
  tab   q     w     e     r     t     y     u     i     o     p     [     ]     \
  caps  a     s     d     f     g     h     j     k     l     ;     '     ret
  lsft  z     x     c     v     b     n     m     ,     .     /     rsft
  lctl  lmet  lalt              spc               ralt  rmet  cmp   rctl
)

(defvar
  ;; one place to tune every double-tap window
  dd 200
  ;; how long a one-shot Shift waits for the key it should modify
  os 1500
)

;; ------------------------------------------------------------
;; State flags + layer overlays
;;
;;  aptp : ON = "I want APT v3 angle"   (remembered across language
;;              switches, so QWERTY<->APT survives EN<->RU)
;;  RU   : ON = "Russian input is active"
;;
;;  Actual base layer = apt  only when  aptp is ON and RU is OFF.
;; ------------------------------------------------------------
(defvirtualkeys
  aptp nop0
  RU   nop1
  vnav (layer-while-held nav)
  vsym (layer-while-held sym)

  ;; double-tap [ on QWERTY
  vlyt (switch
         ((input virtual RU))   (macro [ [)                                                    break
         ((input virtual aptp)) (multi (on-press release-virtualkey aptp) (layer-switch base))  break
         ()                     (multi (on-press press-virtualkey   aptp) (layer-switch apt))   break)

  ;; double-tap [ while already on APT -> back to QWERTY
  vlytoff (multi (on-press release-virtualkey aptp) (layer-switch base))

  ;; fired whenever the OS language is toggled (see @sft below)
  vlang (switch
          ((and (input virtual RU) (input virtual aptp)))
            (multi (on-press release-virtualkey RU) (layer-switch apt))  break
          ((input virtual RU))
            (multi (on-press release-virtualkey RU) (layer-switch base)) break
          ()
            (multi (on-press press-virtualkey   RU) (layer-switch base)) break)
)

(defalias
  ;; ---- entering / leaving the overlay layers -------------------------
  bse  (multi (on-press release-virtualkey vnav) (on-press release-virtualkey vsym))
  gnav (multi (on-press release-virtualkey vsym) (on-press press-virtualkey   vnav))
  gsym (multi (on-press release-virtualkey vnav) (on-press press-virtualkey   vsym))
  fnl  (layer-while-held fn)

  ;; Ctrl: normal Ctrl immediately, double-tap -> nav
  ctl  (tap-dance-eager $dd (lctl @gnav))
  ;; Ctrl inside nav: normal Ctrl immediately, double-tap -> leave nav
  nctl (tap-dance-eager $dd (lctl @bse))

  ;; ' : tap = apostrophe, double-tap -> sym (non-eager, no stray ')
  apo  (tap-dance $dd (' @gsym))
  ;; ' inside sym: tap = \ (the symbol that lives on that key in sym),
  ;;               double-tap -> leave sym
  sapo (tap-dance $dd (\ @bse))

  ;; ---- one-shot Shift -------------------------------------------------
  ;; -press   : consumed by the press of the next key
  ;; -pcancel : pressing Shift again while it is pending cancels it
  ;; holding the key still gives a plain, normal Shift.
  osft (one-shot-press-pcancel $os lsft)

  ;; ---- double-taps from the KLE bottom-centre legends ----------------
  cma  (tap-dance $dd (, tab))       ;; , ,  -> Tab
  dot  (tap-dance $dd (. lalt))      ;; . .  -> Alt
  ;; If you'd rather have a sticky Alt that applies to the NEXT key,
  ;; swap the line above for:
  ;; dot  (tap-dance $dd (. (one-shot 1000 lalt)))

  ;; ---- QWERTY <-> APT v3 angle --------------------------------------
  lyt  (tap-dance $dd ([ (on-press tap-virtualkey vlyt)))
  lytA (tap-dance $dd ([ (on-press tap-virtualkey vlytoff)))

  ;; ---- nav additions (middle legends) --------------------------------
  cpy  C-c
  pst  C-v

  ;; ---- language-switch hook ------------------------------------------
  ;; kanata cannot see the OS input language, so it has to be told.
  ;; Physical Tab outputs Shift here, so Alt + physical-Tab IS Alt+Shift.
  ;; Passing it through to the OS *and* flipping kanata's `RU` flag keeps
  ;; the two in sync.  The Alt branch sends a real (non one-shot) Shift,
  ;; otherwise the hotkey would be eaten by the one-shot machinery.
  lang (on-press tap-virtualkey vlang)
  sft  (switch
         ((input real lalt)) (multi lsft @lang) break
         ()                  @osft              break)

  ;; --- alternatives: use ONE of these instead of the @sft above -------
  ;; Plain one-shot Shift, no language hook at all:
  ;; sft  @osft
  ;;
  ;; Ctrl+Shift  (physical LShift and LCtrl both emit Ctrl here):
  ;; sft  (switch
  ;;        ((or (input real lctl) (input real lsft))) (multi lsft @lang) break
  ;;        ()                                         @osft              break)
  ;;
  ;; Win+Space - put @spc on the spc position in base and apt:
  ;; spc  (switch
  ;;        ((input real lmet)) (multi spc @lang) break
  ;;        ()                  spc               break)
  ;;
  ;; Dedicated key (most reliable - kanata can never drift out of sync).
  ;; Sends the OS hotkey itself and flips the flag. Put @lng somewhere,
  ;; e.g. on the Menu (cmp) key, and use only that key to switch language:
  ;; lng  (multi (macro A-lsft) @lang)
)

;; ------------------------------------------------------------
;; base - QWERTY. tab=one-shot Shift, caps=Backspace, lshift=Ctrl,
;;        ralt=CapsLock
;; ------------------------------------------------------------
(deflayer base
  @sft  q     w     e     r     t     y     u     i     o     p     [     @lyt  \
  bspc  a     s     d     f     g     h     j     k     l     ;     @apo  ret
  @ctl  z     x     c     v     b     n     m     @cma  @dot  /     esc
  @ctl  lmet  lalt              spc               caps  rmet  cmp   @ctl
)

;; ------------------------------------------------------------
;; apt - APT v3 angle, taken from the first (top-left) legend of
;;       every key in the KLE file. Only reachable while `RU` is OFF.
;;       y and b are unused in this layout, so they are dead keys.
;; ------------------------------------------------------------
(deflayer apt
  @sft  w     g     d     f     b     XX    q     l     u     o     y     @lytA  \
  bspc  r     s     t     h     k     j     n     e     a     i     @apo  ret
  @ctl  c     m     p     v     XX    x     z     @cma  @dot  '     esc
  @ctl  lmet  lalt              spc               caps  rmet  cmp   @ctl
)

;; ------------------------------------------------------------
;; nav - arrows on ASDF, page keys on QWER, numpad on the right hand,
;;       Meta/Copy/Paste on XCV, Fn on Z.
;;       Double-tap Ctrl exits.  ' is transparent again: tap it for a
;;       real apostrophe, double-tap it to hop over to sym.
;; ------------------------------------------------------------
(deflayer nav
  _     pgup  home  up    end   _     _     1     2     3     _     _     _     _
  _     pgdn  left  down  rght  _     _     4     5     6     _     _     _
  @nctl @fnl  lmet  @cpy  @pst  _     0     7     8     9     _     _
  @nctl _     _                 _                 _     _     _     @nctl
)

;; ------------------------------------------------------------
;; sym - symbols.  Double-tap ' (the \ key here) exits.
;;       Ctrl is transparent, so it is a plain Ctrl while held - and a
;;       double-tap on it hops over to nav, just like from the base
;;       layer.  Use `lctl` instead of `_` on those four spots if you
;;       never want to leave sym that way.
;; ------------------------------------------------------------
(deflayer sym
  _     S-=   -     /     S-8   _     _     S-3   S-4   S-7   S-2   _     _     _
  _     S--   .     ,     '     =     S-grv S-9   S-[   [     S-\   @sapo _
  _     grv   S-;   ;     S-'   _     _     S-,   S-1   S-/   S-.   _
  _     _     _                 _                 _     _     _     _
)

;; ------------------------------------------------------------
;; fn - held from Z in the nav layer.
;;      F1-F9 stay on the numpad cluster, F10 on the 0 key,
;;      F11 on h and F12 on y.
;; ------------------------------------------------------------
(deflayer fn
  _     _     _     _     _     _     f12   f1    f2    f3    _     _     _     _
  _     _     _     _     _     _     f11   f4    f5    f6    _     _     _
  _     _     _     _     _     _     f10   f7    f8    f9    _     _
  _     _     _                 _                 _     _     _     _
)
